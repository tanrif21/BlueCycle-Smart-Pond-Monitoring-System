   12. Back-to-top
============================================================================ */
(function(){
  'use strict';

  /* ---------- 1. LOADER ---------- */
  window.addEventListener('load', function(){
    var loader = document.getElementById('loader');
    setTimeout(function(){ loader.classList.add('hide'); }, 650);
  });

  /* ---------- 2. THEME TOGGLE ---------- */
  var root = document.documentElement;
  var themeBtn = document.getElementById('theme-toggle');
  var savedTheme = null;
  try{ savedTheme = null; }catch(e){}
  var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  root.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
  themeBtn.addEventListener('click', function(){
    var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
  });

  /* ---------- 3. NAVBAR + MOBILE MENU ---------- */
  var navbar = document.getElementById('navbar');
  var mobileMenu = document.getElementById('mobile-menu');
  var navToggle = document.getElementById('nav-toggle');
  function onScroll(){
    if(window.scrollY > 40){ navbar.classList.add('scrolled'); } else { navbar.classList.remove('scrolled'); }
  }
  window.addEventListener('scroll', onScroll, { passive:true }); onScroll();

  navToggle.addEventListener('click', function(){
    var open = mobileMenu.style.display === 'flex';
    mobileMenu.style.display = open ? 'none' : 'flex';
  });
  mobileMenu.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ mobileMenu.style.display = 'none'; });
  });

  /* ---------- 4. SCROLL PROGRESS ---------- */
  var progress = document.getElementById('scroll-progress');
  function updateProgress(){
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    var pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
    progress.style.width = pct + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive:true }); updateProgress();

  /* ---------- 5. CURSOR GLOW ---------- */
  var glow = document.getElementById('cursor-glow');
  if(window.matchMedia && window.matchMedia('(hover:hover)').matches){
    window.addEventListener('mousemove', function(e){
      glow.style.left = e.clientX + 'px';
      glow.style.top = e.clientY + 'px';
    }, { passive:true });
  }

  /* ---------- 6. SMOOTH SCROLL (anchor links) ---------- */
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var id = a.getAttribute('href');
      if(id.length < 2) return;
      var target = document.querySelector(id);
      if(target){
        e.preventDefault();
        var y = target.getBoundingClientRect().top + window.pageYOffset - 64;
        window.scrollTo({ top:y, behavior:'smooth' });
      }
    });
  });

  /* ---------- 7. REVEAL ON SCROLL ---------- */
  var revealEls = document.querySelectorAll('.reveal');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        entry.target.classList.add('in');
        io.unobserve(entry.target);
      }
    });
  }, { threshold:0.12, rootMargin:'0px 0px -60px 0px' });
  revealEls.forEach(function(el){ io.observe(el); });

  /* ---------- 8. ANIMATED COUNTERS ---------- */
  var counters = document.querySelectorAll('.stat-num');
  var counted = false;
  function runCounters(){
    if(counted) return; counted = true;
    counters.forEach(function(el){
      var target = parseFloat(el.getAttribute('data-count')) || 0;
      var prefix = el.getAttribute('data-prefix') || '';
      var suffix = el.getAttribute('data-suffix') || '';
      var start = 0;
      var duration = 1400;
      var startTime = null;
      function step(ts){
        if(!startTime) startTime = ts;
        var progressT = Math.min((ts - startTime) / duration, 1);
        var eased = 1 - Math.pow(1 - progressT, 3);
        var val = Math.floor(eased * target);
        el.textContent = prefix + val.toLocaleString() + suffix;
        if(progressT < 1){ requestAnimationFrame(step); }
        else{ el.textContent = prefix + target.toLocaleString() + suffix; }
      }
      requestAnimationFrame(step);
    });
  }
  var statsBlock = document.querySelector('.hero-stats');
  if(statsBlock){
    var statsIO = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ runCounters(); statsIO.disconnect(); } });
    }, { threshold:0.4 });
    statsIO.observe(statsBlock);
  }

  /* ---------- 9. TELEMETRY MARQUEE ---------- */
  var track = document.getElementById('telemetry-track');
  if(track){
    var readings = [
      'pH <b>7.10</b>', 'TEMP <b>26.8°C</b>', 'TURBIDITY <b>190</b>', 'LEVEL <b>15.1cm</b>',
      'AUTO MODE <b>ON</b>', 'RELAY <b>4-CH</b>', 'WIFI <b>BlueCycle_Demo</b>', 'STATUS <b>SAFE</b>'
    ];
    var html = readings.map(function(r){ return '<span>● ' + r + '</span>'; }).join('');
    track.innerHTML = html + html; // duplicate for seamless marquee loop
  }

  /* ---------- 10. RIPPLE ON BUTTONS ---------- */
  document.querySelectorAll('.btn').forEach(function(btn){
    btn.addEventListener('click', function(e){
      var rect = btn.getBoundingClientRect();
      var ripple = document.createElement('span');
      var size = Math.max(rect.width, rect.height);
      ripple.className = 'ripple';
      ripple.style.width = ripple.style.height = size + 'px';
      ripple.style.left = (e.clientX - rect.left - size/2) + 'px';
      ripple.style.top = (e.clientY - rect.top - size/2) + 'px';
      btn.appendChild(ripple);
      setTimeout(function(){ ripple.remove(); }, 650);
    });
  });

  /* ---------- 11. SIMULATED LIVE DASHBOARD ---------- */
  var dash = {
    temp: 26.5, ph: 7.00, turb: 180, level: 15.0,
    els: {
      temp: document.getElementById('val-temp'), ph: document.getElementById('val-ph'),
      turb: document.getElementById('val-turb'), level: document.getElementById('val-level'),
      bTemp: document.getElementById('badge-temp'), bPh: document.getElementById('badge-ph'),
      bTurb: document.getElementById('badge-turb'), bLevel: document.getElementById('badge-level'),
      pAcid: document.getElementById('pump-acid'), pBase: document.getElementById('pump-base'),
      pAir: document.getElementById('pump-air'), pWater: document.getElementById('pump-water')
    }
  };
  function setBadge(el, text, ok){
    if(!el) return;
    el.textContent = text;
    el.className = 'pill ' + (ok ? 'pill-ok' : 'pill-warn');
  }
  function toggle(el, on){ if(!el) return; el.classList.toggle('on', on); }
  function tickDashboard(){
    if(!dash.els.temp) return;
    // gentle random walk within realistic prototype ranges
    dash.temp = Math.max(22, Math.min(34, dash.temp + (Math.random()-0.5)*0.8));
    dash.ph = Math.max(5.8, Math.min(9.2, dash.ph + (Math.random()-0.5)*0.25));
    dash.turb = Math.max(120, Math.min(620, dash.turb + (Math.random()-0.5)*40));
    dash.level = Math.max(12.5, Math.min(18, dash.level + (Math.random()-0.5)*0.6));

    dash.els.temp.textContent = dash.temp.toFixed(1);
    dash.els.ph.textContent = dash.ph.toFixed(2);
    dash.els.turb.textContent = Math.round(dash.turb);
    dash.els.level.textContent = dash.level.toFixed(1);

    var tempOk = dash.temp >= 18 && dash.temp <= 32;
    var phOk = dash.ph >= 6.5 && dash.ph <= 8.5;
    var turbOk = dash.turb <= 550;
    var levelOk = dash.level >= 14 && dash.level <= 16;

    setBadge(dash.els.bTemp, tempOk ? 'SAFE' : 'ALERT', tempOk);
    setBadge(dash.els.bPh, phOk ? 'SAFE' : (dash.ph < 6.5 ? 'ACIDIC' : 'BASIC'), phOk);
    setBadge(dash.els.bTurb, turbOk ? 'CLEAN' : 'DIRTY', turbOk);
    setBadge(dash.els.bLevel, levelOk ? 'SAFE' : (dash.level > 16 ? 'UNDERFLOW' : 'OVERFLOW'), levelOk);

    toggle(dash.els.pAir, !tempOk);
    toggle(dash.els.pAcid, dash.ph > 8.5);
    toggle(dash.els.pBase, dash.ph < 6.5);
    toggle(dash.els.pWater, dash.level > 16);
  }
  setInterval(tickDashboard, 2600);

  var chipDemo = document.getElementById('chip-demo'), chipReal = document.getElementById('chip-real');
  var chipAuto = document.getElementById('chip-auto'), chipManual = document.getElementById('chip-manual');
  function setActiveChip(list, active){ list.forEach(function(c){ c.classList.toggle('active', c === active); }); }
  if(chipDemo && chipReal){
    chipDemo.addEventListener('click', function(){ setActiveChip([chipDemo, chipReal], chipDemo); });
    chipReal.addEventListener('click', function(){ setActiveChip([chipDemo, chipReal], chipReal); });
  }
  if(chipAuto && chipManual){
    chipAuto.classList.add('active');
    chipAuto.addEventListener('click', function(){ setActiveChip([chipAuto, chipManual], chipAuto); });
    chipManual.addEventListener('click', function(){ setActiveChip([chipAuto, chipManual], chipManual); });
  }

  /* ---------- 12. BACK TO TOP ---------- */
  var backBtn = document.getElementById('back-to-top');
  window.addEventListener('scroll', function(){
    backBtn.classList.toggle('show', window.scrollY > 700);
  }, { passive:true });
  backBtn.addEventListener('click', function(){
    window.scrollTo({ top:0, behavior:'smooth' });
  });

})();
</script>
</body>
</html>
