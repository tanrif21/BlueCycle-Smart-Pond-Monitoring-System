<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BlueCycle — Smart Pond Monitoring &amp; Automatic Water Quality Management System</title>
<meta name="description" content="BlueCycle is an IoT-based smart pond management system that continuously monitors pH, temperature, turbidity and water level while automatically controlling pumps and feeding through ESP32.">

<!--
  ============================================================================
  BLUECYCLE — SMART POND MONITORING & AUTOMATIC WATER QUALITY MANAGEMENT SYSTEM
  ============================================================================
  Single-file project showcase website.
  Built for: Group 2, Dept. of CSE, United International University
  Structure of this document:
    1. <style>  — design tokens, layout, components, animations
    2. <body>   — loading screen, nav, hero, content sections, footer
    3. <script> — interactions: theme toggle, reveal-on-scroll, counters,
                   live-dashboard simulation, smooth scroll, cursor glow
  No external stylesheets or scripts are used — everything lives in this file.
  ============================================================================
-->

<style>
  /* ==========================================================================
     1. DESIGN TOKENS
     Palette:  Primary #0B3D91 (deep pond-water navy)
               Secondary #00AEEF (surface-light cyan)
               Accent #00C896 (healthy aquatic teal-green)
     Type:     Space Grotesk (display) / Inter (body) / JetBrains Mono (data)
  ========================================================================== */
  :root{
    /* --- brand colors --- */
    --primary:#0B3D91;
    --primary-dark:#082a68;
    --primary-light:#1a56c4;
    --secondary:#00AEEF;
    --accent:#00C896;
    --accent-dark:#00a97e;

    /* --- surface / background (light mode) --- */
    --bg:#F4FAFF;
    --bg-alt:#EAF5FF;
    --surface:#ffffff;
    --glass-bg:rgba(255,255,255,0.62);
    --glass-border:rgba(255,255,255,0.65);
    --glass-shadow:0 20px 60px -20px rgba(11,61,145,0.25);

    /* --- text --- */
    --ink:#0A1B33;
    --ink-soft:#3E4E68;
    --ink-faint:#7285A3;
    --on-primary:#F4FAFF;

    /* --- gradients --- */
    --grad-primary:linear-gradient(135deg,var(--primary) 0%,var(--secondary) 100%);
    --grad-accent:linear-gradient(135deg,var(--secondary) 0%,var(--accent) 100%);
    --grad-bg:radial-gradient(circle at 15% 10%, rgba(0,174,239,0.16), transparent 45%),
              radial-gradient(circle at 85% 0%, rgba(0,200,150,0.14), transparent 40%),
              radial-gradient(circle at 50% 100%, rgba(11,61,145,0.10), transparent 50%),
              var(--bg);

    /* --- layout --- */
    --radius-sm:12px;
    --radius:20px;
    --radius-lg:28px;
    --radius-pill:999px;
    --maxw:1280px;
    --nav-h:76px;

    /* --- fonts --- */
    --font-display:'Space Grotesk','Avenir Next','Century Gothic','Segoe UI',sans-serif;
    --font-body:'Inter','Segoe UI',system-ui,-apple-system,sans-serif;
    --font-mono:'JetBrains Mono','SFMono-Regular',Consolas,'Liberation Mono',monospace;

    /* --- motion --- */
    --ease:cubic-bezier(.16,1,.3,1);
    --ease-soft:cubic-bezier(.4,0,.2,1);
  }

  html[data-theme="dark"]{
    --bg:#050B18;
    --bg-alt:#081026;
    --surface:#0B1730;
    --glass-bg:rgba(13,28,58,0.55);
    --glass-border:rgba(0,174,239,0.22);
    --glass-shadow:0 20px 60px -20px rgba(0,0,0,0.6);
    --ink:#EAF3FF;
    --ink-soft:#AEC1E0;
    --ink-faint:#6E82A8;
    --grad-bg:radial-gradient(circle at 15% 10%, rgba(0,174,239,0.16), transparent 45%),
              radial-gradient(circle at 85% 0%, rgba(0,200,150,0.14), transparent 40%),
              radial-gradient(circle at 50% 100%, rgba(11,61,145,0.30), transparent 50%),
              var(--bg);
  }

  /* ==========================================================================
     2. RESET
  ========================================================================== */
  *,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }
  body{
    font-family:var(--font-body);
    background:var(--grad-bg);
    color:var(--ink);
    line-height:1.6;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
    transition:background .4s var(--ease-soft), color .4s var(--ease-soft);
  }
  img,svg{ display:block; max-width:100%; }
  a{ color:inherit; text-decoration:none; }
  ul{ list-style:none; }
  button{ font-family:inherit; cursor:pointer; border:none; background:none; color:inherit; }
  input,select{ font-family:inherit; }
  h1,h2,h3,h4{ font-family:var(--font-display); font-weight:600; letter-spacing:-0.02em; color:var(--ink); }

  ::selection{ background:var(--accent); color:#fff; }

  /* premium scrollbar */
  ::-webkit-scrollbar{ width:11px; }
  ::-webkit-scrollbar-track{ background:var(--bg-alt); }
  ::-webkit-scrollbar-thumb{ background:var(--grad-primary); border-radius:99px; border:3px solid var(--bg-alt); }
  ::-webkit-scrollbar-thumb:hover{ background:var(--grad-accent); }

  :focus-visible{ outline:2.5px solid var(--secondary); outline-offset:3px; border-radius:4px; }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important; }
  }

  /* ==========================================================================
     3. LAYOUT UTILITIES
  ========================================================================== */
  .wrap{ max-width:var(--maxw); margin:0 auto; padding:0 32px; }
  .section{ position:relative; padding:140px 0; }
  .section-tight{ padding:100px 0; }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:var(--font-mono); font-size:12.5px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--primary); background:rgba(0,174,239,0.1); border:1px solid rgba(0,174,239,0.25);
    padding:7px 16px; border-radius:var(--radius-pill); margin-bottom:22px; font-weight:600;
  }
  html[data-theme="dark"] .eyebrow{ color:var(--secondary); background:rgba(0,174,239,0.12); }
  .eyebrow .dot{ width:6px; height:6px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 4px rgba(0,200,150,0.25); }

  .head-block{ max-width:680px; margin-bottom:64px; }
  .head-block.center{ margin-left:auto; margin-right:auto; text-align:center; }
  .head-block h2{ font-size:clamp(2rem,4vw,3rem); line-height:1.12; margin-bottom:18px; }
  .head-block p{ color:var(--ink-soft); font-size:1.08rem; }

  .grad-text{
    background:var(--grad-primary); -webkit-background-clip:text; background-clip:text; color:transparent;
  }

  /* buttons */
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:10px;
    font-family:var(--font-body); font-weight:600; font-size:0.95rem;
    padding:15px 30px; border-radius:var(--radius-pill);
    cursor:pointer; position:relative; overflow:hidden; isolation:isolate;
    transition:transform .35s var(--ease), box-shadow .35s var(--ease), background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease);
    white-space:nowrap;
  }
  .btn:active{ transform:scale(0.97); }
  .btn-primary{ background:var(--grad-primary); color:#fff; box-shadow:0 14px 30px -10px rgba(11,61,145,0.55); }
  .btn-primary:hover{ transform:translateY(-3px); box-shadow:0 20px 40px -12px rgba(11,61,145,0.6); }
  .btn-accent{ background:var(--grad-accent); color:#04241c; box-shadow:0 14px 30px -10px rgba(0,200,150,0.5); }
  .btn-accent:hover{ transform:translateY(-3px); box-shadow:0 20px 40px -12px rgba(0,200,150,0.55); }
  .btn-ghost{
    background:var(--glass-bg); color:var(--ink); border:1.5px solid var(--glass-border);
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  }
  .btn-ghost:hover{ transform:translateY(-3px); border-color:var(--secondary); box-shadow:0 14px 30px -14px rgba(11,61,145,0.35); }
  .btn-sm{ padding:11px 22px; font-size:0.86rem; }
  .btn-disabled{ opacity:0.55; cursor:not-allowed; }
  .btn-disabled:hover{ transform:none; }
  .btn .ripple{ position:absolute; border-radius:50%; background:rgba(255,255,255,0.55); transform:scale(0); animation:ripple .6s var(--ease-soft); pointer-events:none; }
  @keyframes ripple{ to{ transform:scale(3.2); opacity:0; } }

  /* glass card */
  .glass{
    background:var(--glass-bg); border:1px solid var(--glass-border);
    backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
    border-radius:var(--radius-lg); box-shadow:var(--glass-shadow);
  }

  /* reveal on scroll */
  .reveal{ opacity:0; transform:translateY(36px); transition:opacity .9s var(--ease), transform .9s var(--ease); }
  .reveal.in{ opacity:1; transform:translateY(0); }
  .reveal-stagger > *{ transition-delay:calc(var(--i,0) * 90ms); }

  /* badges / pills */
  .pill{
    display:inline-flex; align-items:center; gap:6px; font-size:0.78rem; font-weight:600;
    padding:5px 13px; border-radius:var(--radius-pill); font-family:var(--font-mono); letter-spacing:0.03em;
  }
  .pill-ok{ background:rgba(0,200,150,0.14); color:var(--accent-dark); }
  html[data-theme="dark"] .pill-ok{ color:#4CE8BC; }
  .pill-info{ background:rgba(0,174,239,0.14); color:#0089bf; }
  html[data-theme="dark"] .pill-info{ color:var(--secondary); }
  .pill-warn{ background:rgba(255,150,60,0.15); color:#c1670c; }

  /* ==========================================================================
     4. LOADING SCREEN
  ========================================================================== */
  #loader{
    position:fixed; inset:0; z-index:9999; background:var(--primary);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px;
    transition:opacity .7s var(--ease-soft), visibility .7s var(--ease-soft);
  }
  #loader.hide{ opacity:0; visibility:hidden; pointer-events:none; }
  .loader-ring{ width:64px; height:64px; position:relative; }
  .loader-ring::before,.loader-ring::after{
    content:''; position:absolute; inset:0; border-radius:50%;
    border:3px solid transparent; border-top-color:var(--secondary); border-right-color:var(--accent);
    animation:spin 1.1s linear infinite;
  }
  .loader-ring::after{ inset:10px; border-top-color:var(--accent); border-right-color:transparent; border-left-color:var(--secondary); animation-duration:.8s; animation-direction:reverse; }
  @keyframes spin{ to{ transform:rotate(360deg); } }
  .loader-word{ font-family:var(--font-mono); color:#cfe9ff; letter-spacing:0.3em; font-size:12px; text-transform:uppercase; }
  .loader-title{ font-family:var(--font-display); color:#fff; font-size:1.4rem; letter-spacing:0.02em; }

  /* ==========================================================================
     5. SCROLL PROGRESS + CURSOR GLOW + BACK TO TOP
  ========================================================================== */
  #scroll-progress{
    position:fixed; top:0; left:0; height:3px; width:0%; z-index:2000;
    background:var(--grad-accent); box-shadow:0 0 12px rgba(0,200,150,0.6);
    transition:width .1s linear;
  }
  #cursor-glow{
    position:fixed; width:420px; height:420px; border-radius:50%; pointer-events:none; z-index:1;
    background:radial-gradient(circle, rgba(0,174,239,0.14), transparent 70%);
    transform:translate(-50%,-50%); left:50%; top:50%; transition:opacity .4s ease; opacity:0;
  }
  @media(hover:hover){ #cursor-glow{ opacity:1; } }

  #back-to-top{
    position:fixed; right:26px; bottom:26px; z-index:900; width:52px; height:52px; border-radius:50%;
    background:var(--grad-primary); color:#fff; display:flex; align-items:center; justify-content:center;
    box-shadow:0 14px 30px -10px rgba(11,61,145,0.55); opacity:0; transform:translateY(16px) scale(.8); pointer-events:none;
    transition:opacity .4s var(--ease), transform .4s var(--ease);
  }
  #back-to-top.show{ opacity:1; transform:translateY(0) scale(1); pointer-events:auto; }
  #back-to-top:hover{ transform:translateY(-4px) scale(1.05); }

  /* ==========================================================================
     6. NAVBAR
  ========================================================================== */
  #navbar{
    position:fixed; top:0; left:0; right:0; z-index:1000; height:var(--nav-h);
    display:flex; align-items:center; transition:background .4s var(--ease-soft), box-shadow .4s var(--ease-soft), height .3s var(--ease-soft);
  }
  #navbar.scrolled{
    background:var(--glass-bg); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);
    box-shadow:0 8px 30px -14px rgba(11,61,145,0.25); border-bottom:1px solid var(--glass-border); height:66px;
  }
  .nav-inner{ width:100%; max-width:var(--maxw); margin:0 auto; padding:0 32px; display:flex; align-items:center; justify-content:space-between; }
  .brand{ display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-weight:700; font-size:1.28rem; }
  .brand-mark{ width:36px; height:36px; border-radius:11px; background:var(--grad-primary); display:flex; align-items:center; justify-content:center; box-shadow:0 8px 18px -6px rgba(11,61,145,0.5); }
  .brand-mark svg{ width:20px; height:20px; }
  .nav-links{ display:flex; align-items:center; gap:2px; }
  .nav-links a{
    font-size:0.9rem; font-weight:500; color:var(--ink-soft); padding:10px 15px; border-radius:var(--radius-pill);
    transition:color .3s ease, background .3s ease; position:relative;
  }
  .nav-links a:hover{ color:var(--primary); background:rgba(0,174,239,0.09); }
  html[data-theme="dark"] .nav-links a:hover{ color:var(--secondary); }
  .nav-actions{ display:flex; align-items:center; gap:12px; }
  .icon-btn{
    width:42px; height:42px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    background:var(--glass-bg); border:1px solid var(--glass-border); transition:transform .3s var(--ease), border-color .3s ease;
  }
  .icon-btn:hover{ transform:translateY(-2px) rotate(-6deg); border-color:var(--secondary); }
  .icon-btn svg{ width:18px; height:18px; }
  .theme-icon-dark{ display:none; }
  html[data-theme="dark"] .theme-icon-light{ display:none; }
  html[data-theme="dark"] .theme-icon-dark{ display:block; }
  #nav-toggle{ display:none; }

  /* ==========================================================================
     7. HERO
  ========================================================================== */
  #hero{
    position:relative; min-height:100vh; display:flex; align-items:center; overflow:hidden;
    padding-top:var(--nav-h);
  }
  .hero-bg{ position:absolute; inset:0; z-index:0; overflow:hidden; }
  .blob{ position:absolute; border-radius:50%; filter:blur(70px); opacity:0.55; animation:float-blob 16s ease-in-out infinite; }
  .blob-1{ width:520px; height:520px; background:radial-gradient(circle,var(--secondary),transparent 70%); top:-160px; left:-120px; animation-duration:18s; }
  .blob-2{ width:460px; height:460px; background:radial-gradient(circle,var(--accent),transparent 70%); bottom:-140px; right:-100px; animation-duration:22s; animation-delay:-4s; }
  .blob-3{ width:340px; height:340px; background:radial-gradient(circle,var(--primary),transparent 70%); top:40%; right:8%; opacity:0.35; animation-duration:14s; animation-delay:-8s; }
  @keyframes float-blob{
    0%,100%{ transform:translate(0,0) scale(1); }
    33%{ transform:translate(40px,-30px) scale(1.08); }
    66%{ transform:translate(-30px,25px) scale(0.95); }
  }

  .hero-grid-lines{
    position:absolute; inset:0; opacity:0.5;
    background-image:linear-gradient(rgba(11,61,145,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(11,61,145,0.05) 1px,transparent 1px);
    background-size:46px 46px; mask-image:radial-gradient(ellipse 80% 60% at 50% 30%,#000 40%,transparent 90%);
  }
  html[data-theme="dark"] .hero-grid-lines{
    background-image:linear-gradient(rgba(0,174,239,0.08) 1px,transparent 1px),linear-gradient(90deg,rgba(0,174,239,0.08) 1px,transparent 1px);
  }

  /* particle bubbles rising through hero */
  .bubble{
    position:absolute; bottom:-40px; border-radius:50%;
    background:radial-gradient(circle at 30% 30%, rgba(255,255,255,0.9), rgba(0,174,239,0.15));
    border:1px solid rgba(255,255,255,0.5);
    animation:rise linear infinite;
  }
  @keyframes rise{
    0%{ transform:translateY(0) translateX(0); opacity:0; }
    10%{ opacity:0.7; }
    90%{ opacity:0.5; }
    100%{ transform:translateY(-115vh) translateX(20px); opacity:0; }
  }

  /* node network overlay - IoT signature motif */
  .node-net{ position:absolute; inset:0; z-index:0; opacity:0.55; }
  .node-net circle{ animation:pulse-node 3.2s ease-in-out infinite; }
  @keyframes pulse-node{ 0%,100%{ opacity:0.35; r:2.4; } 50%{ opacity:1; r:4; } }
  .node-net line{ stroke-dasharray:5 7; animation:dash-move 6s linear infinite; }
  @keyframes dash-move{ to{ stroke-dashoffset:-120; } }

  /* wave layers at hero base */
  .wave-wrap{ position:absolute; left:0; right:0; bottom:0; height:220px; z-index:1; }
  .wave-wrap svg{ position:absolute; bottom:0; width:200%; height:100%; }
  .wave-1{ animation:wave-move 13s linear infinite; opacity:0.5; }
  .wave-2{ animation:wave-move 19s linear infinite reverse; opacity:0.65; }
  .wave-3{ animation:wave-move 25s linear infinite; opacity:0.9; }
  @keyframes wave-move{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }

  .hero-inner{ position:relative; z-index:2; width:100%; text-align:center; padding:60px 0 40px; }
  .hero-badge{
    display:inline-flex; align-items:center; gap:9px; font-family:var(--font-mono); font-size:12.5px;
    letter-spacing:0.12em; text-transform:uppercase; color:var(--primary); background:var(--glass-bg);
    border:1px solid var(--glass-border); padding:9px 18px 9px 10px; border-radius:var(--radius-pill);
    backdrop-filter:blur(12px); margin-bottom:30px; box-shadow:var(--glass-shadow);
  }
  html[data-theme="dark"] .hero-badge{ color:var(--secondary); }
  .hero-badge .flag{ background:var(--grad-accent); color:#04241c; padding:3px 9px; border-radius:99px; font-weight:700; letter-spacing:0.04em; }

  .hero-title{
    font-size:clamp(3.4rem,9vw,7.2rem); line-height:0.95; font-weight:700; letter-spacing:-0.03em;
    background:linear-gradient(135deg,var(--primary) 0%,var(--secondary) 55%,var(--accent) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    margin-bottom:26px; animation:title-in 1.1s var(--ease) both;
  }
  @keyframes title-in{ from{ opacity:0; transform:translateY(28px) scale(.97); } to{ opacity:1; transform:translateY(0) scale(1); } }

  .hero-sub{
    max-width:640px; margin:0 auto 42px; font-size:1.2rem; color:var(--ink-soft); font-weight:500;
    animation:title-in 1.1s var(--ease) .1s both;
  }
  .hero-actions{ display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap; margin-bottom:70px; animation:title-in 1.1s var(--ease) .2s both; }

  .hero-stats{
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px; max-width:920px; margin:0 auto;
    background:var(--glass-border); border-radius:var(--radius-lg); overflow:hidden; border:1px solid var(--glass-border);
    animation:title-in 1.1s var(--ease) .3s both; box-shadow:var(--glass-shadow);
  }
  .stat-cell{ background:var(--glass-bg); backdrop-filter:blur(18px); padding:26px 12px; text-align:center; }
  .stat-num{ font-family:var(--font-display); font-size:clamp(1.5rem,3vw,2.1rem); font-weight:700; color:var(--primary); }
  html[data-theme="dark"] .stat-num{ color:var(--secondary); }
  .stat-label{ font-size:0.78rem; color:var(--ink-faint); margin-top:4px; font-weight:600; letter-spacing:0.02em; }

  .telemetry-bar{
    margin:34px auto 0; max-width:920px; overflow:hidden; border-radius:var(--radius-pill);
    background:var(--glass-bg); border:1px solid var(--glass-border); padding:11px 0;
    animation:title-in 1.1s var(--ease) .4s both;
  }
  .telemetry-track{ display:flex; gap:40px; white-space:nowrap; animation:marquee 22s linear infinite; width:max-content; }
  @keyframes marquee{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }
  .telemetry-track span{ font-family:var(--font-mono); font-size:0.82rem; color:var(--ink-soft); display:inline-flex; align-items:center; gap:8px; }
  .telemetry-track b{ color:var(--accent-dark); }
  html[data-theme="dark"] .telemetry-track b{ color:var(--accent); }

  .scroll-cue{
    position:absolute; left:50%; bottom:26px; transform:translateX(-50%); z-index:2;
    display:flex; flex-direction:column; align-items:center; gap:8px; color:var(--ink-faint);
    font-family:var(--font-mono); font-size:11px; letter-spacing:0.16em; text-transform:uppercase;
    animation:bob 2.4s ease-in-out infinite;
  }
  @keyframes bob{ 0%,100%{ transform:translate(-50%,0); } 50%{ transform:translate(-50%,8px); } }
  .scroll-cue .mouse{ width:24px; height:38px; border:2px solid var(--ink-faint); border-radius:14px; position:relative; }
  .scroll-cue .mouse::before{ content:''; position:absolute; top:6px; left:50%; width:4px; height:8px; background:var(--secondary); border-radius:3px; transform:translateX(-50%); animation:wheel 1.6s ease-in-out infinite; }
  @keyframes wheel{ 0%{ opacity:1; top:6px; } 100%{ opacity:0; top:18px; } }

  /* ==========================================================================
     8. ABOUT / PROJECT IDEA
  ========================================================================== */
  .about-grid{ display:grid; grid-template-columns:1.1fr 0.9fr; gap:64px; align-items:center; }
  .about-copy p{ color:var(--ink-soft); margin-bottom:16px; font-size:1.04rem; }
  .about-copy p strong{ color:var(--ink); }
  .about-list{ margin-top:26px; display:flex; flex-direction:column; gap:14px; }
  .about-list li{ display:flex; gap:12px; align-items:flex-start; color:var(--ink-soft); font-size:0.98rem; }
  .about-list .tick{
    flex:none; width:22px; height:22px; border-radius:50%; background:var(--grad-accent);
    display:flex; align-items:center; justify-content:center; margin-top:2px;
  }
  .about-list .tick svg{ width:12px; height:12px; }

  .pond-illustration{ position:relative; aspect-ratio:1/1; border-radius:var(--radius-lg); overflow:hidden; }
  .pond-illustration svg{ width:100%; height:100%; }

  .quote-block{
    margin-top:100px; padding:56px; border-radius:var(--radius-lg); position:relative; text-align:center;
